<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\DTO\Followups\FollowUpResponseDto.cs" />
  </ItemGroup>

  <!--
    Build output (bin\Debug\net8.0\*) used to be listed here as Content/None items.
    That is removed: it risks publishing a stale appsettings.json from a previous
    Debug build over the real one, which for a config file that now carries auth
    settings is a security problem, not just untidiness.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Dapper" Version="2.1.15" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\templates\assets\Images\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Downloads\latest_schema.sql" Link="Database\SQL_Scripts\latest_schema.sql" />
  </ItemGroup>

</Project>
